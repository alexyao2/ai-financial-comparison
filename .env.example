# App subscriptions do not supply API credits. Obtain separate API keys.
# Never commit .env. Leave credentials blank until you want a live run.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
# USD per million tokens for your exact model; verify current provider pricing.
# All billable output/reasoning tokens must be covered by OUTPUT_PRICE.
OPENAI_INPUT_PRICE=
OPENAI_OUTPUT_PRICE=
GEMINI_INPUT_PRICE=
GEMINI_OUTPUT_PRICE=
# Zero is appropriate only when your account is on the Groq free plan.
GROQ_INPUT_PRICE=0
GROQ_OUTPUT_PRICE=0
